group_omni = 'Omnibus: Selection'
i_omni_mode = input.string('Auto (Framework Allocation)', 'Member Selection', options = ['Auto (Framework Allocation)', 'Manual (Members List)'], group = group_omni, tooltip = 'Auto: every model the sector framework enables, each a member in its own right.\n\nManual: the models listed in Members. Every model is listed by default, so Manual starts equal to Auto; delete a code to remove a model.\n\nEither way rNPV replaces the DCF it contains, P/AFFO (an FCF proxy) gives way to P/FCF, and a member is dropped if its model returns na or a non-positive value. The table row "Omnibus Members" reports what survived.')
i_omni_strict = input.bool(true, 'Manual: still require framework approval', group = group_omni, tooltip = 'ON (default): a listed model is used only if the sector framework ALSO enables it.\n\nOFF: the list overrides the framework; a listed sector model is computed even outside its sector.')
i_om_codes = input.string('PE PS FCF PB TBV EV CF AFFO RNPV ECF ADCF UNB APV EVA DDM DCF RIM EPV GRA R40 ACQ OE', 'Members (Manual)', group = group_omni, tooltip = 'Model codes separated by spaces, used when Member Selection is Manual.\n\nRelative: PE P/E, PS P/S, FCF P/FCF, PB P/B, TBV P/TBV, EV EV/EBITDA, CF P/CF, AFFO P/AFFO.\nSector: RNPV rNPV, ECF Equity Cash Flow, ADCF AFFO DCF, UNB Unbundled, APV Adjusted PV, EVA Economic Value Added, DDM Dividend Discount.\nAbsolute: DCF, RIM Residual Income, EPV Greenwald, GRA Graham, R40 Rule of 40, ACQ Acquirer\'s Multiple, OE Owners\' Earnings.\n\nCOMP = the whole Standard blend as a SINGLE member (not listed by default: Standard and Omnibus are alternatives). WARNING: it already contains the relative multiples and sector models, plus the absolute models the framework is named after (Technology: DCF, RIM, Rule of 40; Financials: RIM). Listing it alongside any of them counts those models twice. The Omnibus Members row flags this as DOUBLE-COUNT.')
i_omni_sanity_x = input.float(10.0, 'Drop members beyond Nx / (1/N)x price', minval = 0, maxval = 50, step = 1, group = group_omni, tooltip = 'A member whose fair value exceeds N times the current price, or falls below 1/N of it, is excluded.\n\n0 = off. The Standard Composite member is never dropped by this test.')

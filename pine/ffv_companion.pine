//@version=6
// FFV Companion Feed: fetches the line items Fundamental Fair Value Pro has no request slot
// for and hands them over as Data Window plots, which the main script links as sources.
// It only FETCHES: every value goes into the main script's data engine as a candidate
// input, where the exact identities, quality tiers, staleness cap and sanity checks apply.
// Release timing is the main script's own (FFVLib.release), and the report lag is sealed
// into the check value so the two scripts cannot run on different lags.
// Also computes Buffett's owner earnings (1986): net income + D&A + impairments
// - average maintenance capital spending - lasting working-capital build-up.
indicator('FFV Companion Feed', overlay = true)
import YOUR_TV_USERNAME/FFVLib/2 as FL

i_lag = input.int(45, 'Report lag (days)', minval = 0, maxval = 120, tooltip = 'Must equal the main script setting: the check value carries it, and the main script ignores the feed on a mismatch.')
i_avg = input.int(3, 'Owner earnings: averaging years', minval = 1, maxval = 4, tooltip = 'Maintenance capital spending and the working-capital build-up are averaged over this many years, as Buffett prescribes (average, not one year).')
i_nc = input.bool(false, 'Owner earnings: add back other non-cash items', tooltip = 'Other non-cash items include stock-based compensation, which Buffett counts as a real cost. Off by default.')
i_acq = input.bool(false, 'Owner earnings: treat acquisitions as capital spending', tooltip = 'For companies that grow by buying businesses rather than building them.')
i_tbl = input.bool(true, 'Show breakdown table')

f(string id, string per) =>
    request.financial(syminfo.tickerid, id, per, ignore_invalid_symbol = true, currency = syminfo.currency)
float earn_raw = request.earnings(syminfo.tickerid, earnings.actual, ignore_invalid_symbol = true)
bool report_bar = not na(earn_raw) and (na(earn_raw[1]) or earn_raw != earn_raw[1])

// 27 requests. Index: 0-2 equity chain | 3-5 gross profit chain | 6-9 EBITDA chain |
// 10-12 capex chain | 13-14 cash-flow D&A (8 doubles as its backup) | 15-25 owner earnings.
array<float> raw = array.from(
     f('TOTAL_EQUITY', 'FQ'), f('SHRHLDRS_EQUITY', 'FQ'), f('BOOK_VALUE_PER_SHARE', 'FQ'),
     f('GROSS_PROFIT', 'TTM'), f('GROSS_MARGIN', 'TTM'), f('COGS_TO_REVENUE', 'FQ'),
     f('EBITDA', 'TTM'), f('OPER_INCOME', 'TTM'), f('DEPRECIATION_DEPLETION', 'FQ'), f('EBITDA_MARGIN', 'TTM'),
     f('CAPITAL_EXPENDITURES', 'FQ'), f('CAPITAL_EXPENDITURES_FIXED_ASSETS', 'FQ'), f('CAPITAL_EXPENDITURES_OTHER_ASSETS', 'FQ'),
     f('CASH_FLOW_DEPRECATION_N_AMORTIZATION', 'FQ'), f('AMORTIZATION', 'FQ'),
     f('NET_INCOME', 'TTM'), f('IMPAIRMENTS', 'FY'), f('TOTAL_REVENUE', 'TTM'), f('PPE_TOTAL_NET', 'FQ'), f('DILUTED_SHARES_OUTSTANDING', 'FQ'),
     f('PURCHASE_OF_BUSINESS', 'FQ'), f('CHANGES_IN_WORKING_CAPITAL', 'FQ'), f('CHANGE_IN_INVENTORIES', 'FQ'),
     f('CHANGE_IN_ACCOUNTS_RECEIVABLE', 'FQ'), f('CHANGE_IN_ACCOUNTS_PAYABLE', 'FQ'), f('NON_CASH_ITEMS', 'FQ'))
int NR = 26
var array<float> pend = array.new_float(NR, na)
var array<float> known = array.new_float(NR, na)
var array<int> seen = array.new_int(NR, 0)
bool changed = FL.release(raw, pend, known, seen, i_lag, report_bar)
K(int i) =>
    known.get(i)
// TradingView ratios may come as percent: a margin above 3 is read as percent.
pct(float x) =>
    na(x) ? na : math.abs(x) > 3 ? x / 100 : x

// ---------- QUARTER STORE ----------
// One row per quarter, newest first: the quarterly flows as released (a value repeating the
// previous quarter's exactly counts as missing: a frozen field), then TTM revenue,
// maintenance capex and working-capital change (for the year-ago and the averages).
var array<int> FLOW = array.from(8, 10, 11, 12, 13, 14, 20, 21, 22, 23, 24, 25)
int NF = 12
int C_REV = 12, int C_MNT = 13, int C_WC = 14
var matrix<float> Q = matrix.new<float>(0, 15, na)
f_fresh(float v) =>
    not na(v) and (na(v[1]) or v != v[1])
bool fr1 = f_fresh(K(17)), bool fr2 = f_fresh(K(15)), bool fr3 = f_fresh(K(0)), bool fr4 = f_fresh(K(10))
// Bars per year as the main script counts them; a new quarter needs 45 days since the last.
int tf_sec = math.max(timeframe.in_seconds(timeframe.period), 1)
float bpy = tf_sec < 86400 ? 252 * 23400.0 / tf_sec : tf_sec < 604800 ? 252 * 86400.0 / tf_sec : 365.25 * 86400.0 / tf_sec
int min_gap = math.max(1, int(bpy * 45 / 365.25))
var int last_q = -100000
if (fr1 or fr2 or fr3 or fr4) and bar_index - last_q >= min_gap
    last_q := bar_index
    Q.add_row(0, array.new_float(15, na))
    if Q.rows() > 20
        Q.remove_row(20)
// Column j from row r: na outside the store.
q(int r, int j) =>
    r < Q.rows() ? Q.get(r, j) : na
// TTM of flow column j starting at row r: the sum of 4 quarters; fewer are annualised from
// their mean (as the main script does); none -> na.
ttm(int r, int j) =>
    float s = 0.0
    int n = 0
    for k = r to r + 3
        float x = q(k, j)
        if not na(x)
            s += x
            n += 1
    n == 0 ? na : n == 4 ? s : s / n * 4.0
// Mean of column j over the rows 0, 4, 8, ... (one per year, up to yrs years).
yavg(int j, int yrs) =>
    float s = 0.0
    int n = 0
    for y = 0 to yrs - 1
        float x = q(4 * y, j)
        if not na(x)
            s += x
            n += 1
    n == 0 ? na : s / n

// ---------- OUTPUTS: each item down its chain; code 1 = reported, 2 = reported parts, 3 = from a ratio ----------
// The first reported (non-na) of up to three candidates, with its code (0 = none).
pick(float a, int ca, float b, int cb, float c, int cc) =>
    float v = na
    int cd = 0
    if not na(a)
        v := a
        cd := ca
    else if not na(b)
        v := b
        cd := cb
    else if not na(c)
        v := c
        cd := cc
    [v, cd]
var float o_eq = na
var float o_gp = na
var float o_ed = na
var float o_cx = na
var float o_da = na
var float o_oe = na
var int c_eq = 0
var int c_gp = 0
var int c_ed = 0
var int c_cx = 0
var int c_da = 0
var int c_oe = 0
var array<float> B = array.new_float(9, na) // breakdown: NI, D&A, impairments, non-cash, maintenance, WC, acquisitions, total capex, growth capex
if Q.rows() > 0 and (changed or last_q == bar_index)
    // Rewrite the open quarter (late fields and restatements land here).
    for [k, i] in FLOW
        float x = K(i)
        float prev = q(1, k)
        Q.set(0, k, not na(prev) and x == prev ? na : x)
    float rev = K(17)
    Q.set(0, C_REV, rev)
    // Equity
    [e, ce] = pick(K(0), 1, K(1), 2, K(2) * K(19) > 0 ? K(2) * K(19) : na, 3)
    o_eq := e
    c_eq := ce
    // Gross profit (TTM)
    float gm = pct(K(4)), float cr = pct(K(5))
    [g, cg] = pick(K(3), 1, rev > 0 ? gm * rev : na, 3, rev > 0 ? rev * (1 - cr) : na, 3)
    o_gp := g
    c_gp := cg
    // Cash-flow D&A (TTM): reported, else depreciation & depletion + amortisation
    float da1 = ttm(0, 4), float dd = ttm(0, 0), float am = ttm(0, 5)
    [d, cd] = pick(da1, 1, dd + nz(am), 2, na, 0)
    o_da := d
    c_da := cd
    // EBITDA (TTM)
    float em = pct(K(9))
    [ed, ced] = pick(K(6), 1, K(7) + dd, 2, rev > 0 ? em * rev : na, 3)
    o_ed := ed
    c_ed := ced
    // Capital spending (TTM, negative like the cash-flow line)
    float cx1 = ttm(0, 1), float cxf = ttm(0, 2), float cxo = ttm(0, 3)
    [cx, ccx] = pick(-math.abs(cx1), 1, -(math.abs(cxf) + math.abs(nz(cxo))), 2, na, 0)
    o_cx := cx
    c_cx := ccx
    // ---- Owner earnings ----
    // Maintenance capex = total - growth capex; growth capex = revenue growth x net PPE / revenue
    // (Greenwald), held to [0, total]. No year-ago revenue: no growth credit (all maintenance).
    float cxa = math.abs(cx)
    float rev_1y = q(4, C_REV)
    float ppe = K(18)
    float gcx = not na(rev_1y) and rev > 0 and ppe > 0 ? math.min(math.max((rev - rev_1y) * ppe / rev, 0.0), nz(cxa)) : 0.0
    Q.set(0, C_MNT, na(cx) ? na : cxa - gcx)
    // Working capital: the cash-flow change (negative = build-up), else inventories +
    // receivables + payables changes.
    float wc = ttm(0, 7)
    float wc_p = ttm(0, 8) + ttm(0, 9) + ttm(0, 10)
    Q.set(0, C_WC, nz(wc, wc_p))
    float mnt = yavg(C_MNT, i_avg)
    float wca = yavg(C_WC, i_avg)
    float ni = K(15)
    float acq = i_acq ? math.abs(nz(ttm(0, 6))) : 0.0
    float nc = i_nc ? nz(ttm(0, 11)) : 0.0
    float imp = nz(K(16))
    float sh = K(19)
    bool fin_sector = str.contains(syminfo.sector, 'Financ')
    // Needs reported net income, D&A and capital spending; banks: N/A.
    float oe = fin_sector or na(ni) or na(d) or na(mnt) ? na : ni + d + imp + nc - mnt + math.min(nz(wca), 0.0) - acq
    o_oe := sh > 0 ? oe / sh : na
    c_oe := na(o_oe) ? 0 : 1
    B := array.from(ni, d, imp, nc, mnt, math.min(nz(wca), 0.0), acq, cxa, gcx)

// ---------- HAND-OVER ----------
// Codes: report lag + 1000 x (sum of code_i x 4^i), an exact integer. Check: a weighted
// sum of each value's mantissa (FL.mant), so a link left on its default (the close) or
// swapped with another fails the main script's recomputation at any scale.
float codes = i_lag + 1000.0 * (c_eq + 4 * c_gp + 16 * c_ed + 64 * c_cx + 256 * c_da + 1024 * c_oe)
float check = 2 * FL.mant(o_eq) + 3 * FL.mant(o_gp) + 4 * FL.mant(o_ed) + 5 * FL.mant(o_cx) + 6 * FL.mant(o_da) + 7 * FL.mant(o_oe) + 8 * FL.mant(codes)
plot(o_eq, 'FFV Equity', display = display.data_window)
plot(o_gp, 'FFV Gross profit', display = display.data_window)
plot(o_ed, 'FFV EBITDA', display = display.data_window)
plot(o_cx, 'FFV Capex', display = display.data_window)
plot(o_da, 'FFV D&A', display = display.data_window)
plot(o_oe, 'FFV Owner earnings per share', display = display.data_window)
plot(codes, 'FFV Codes', display = display.data_window)
plot(check, 'FFV Check', display = display.data_window)

// ---------- BREAKDOWN TABLE ----------
var table tb = table.new(position.bottom_right, 3, 16, bgcolor = color.new(color.black, 10), border_width = 1)
fmt(float x) =>
    na(x) ? 'N/A' : str.tostring(x, format.volume)
src(int c) =>
    c == 1 ? 'reported' : c == 2 ? 'from parts' : c == 3 ? 'from a ratio' : 'missing'
row(int r, string a, string b, string c) =>
    table.cell(tb, 0, r, a, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, b, text_color = color.white, text_size = size.small)
    table.cell(tb, 2, r, c, text_color = color.gray, text_size = size.small)
if barstate.islast and i_tbl
    row(0, 'FFV Companion Feed', 'Value', 'Source')
    row(1, 'Equity', fmt(o_eq), src(c_eq))
    row(2, 'Gross profit (TTM)', fmt(o_gp), src(c_gp))
    row(3, 'EBITDA (TTM)', fmt(o_ed), src(c_ed))
    row(4, 'Capital spending (TTM)', fmt(o_cx), src(c_cx))
    row(5, 'D&A, cash flow (TTM)', fmt(o_da), src(c_da))
    row(6, 'OWNER EARNINGS', '', str.tostring(i_avg) + 'y averages')
    row(7, 'Net income (TTM)', fmt(B.get(0)), '')
    row(8, '+ D&A', fmt(B.get(1)), '')
    row(9, '+ Impairments (last FY)', fmt(B.get(2)), '')
    row(10, '+ Other non-cash items', i_nc ? fmt(B.get(3)) : 'off', 'incl. stock pay')
    row(11, '- Maintenance capex', fmt(B.get(4)), 'total ' + fmt(B.get(7)) + ', growth ' + fmt(B.get(8)))
    row(12, '- Working-capital build-up', fmt(-B.get(5)), '')
    row(13, '- Acquisitions', i_acq ? fmt(B.get(6)) : 'off', '')
    row(14, '= Owner earnings / share', na(o_oe) ? 'N/A' : str.tostring(o_oe, '#.##'), syminfo.currency)
    row(15, 'Report lag', str.tostring(i_lag) + ' days', 'must match main')
